# Option 1: Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key

# Option 2: Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Models (override per role if you like)
LEADGEN_FAST_MODEL=gemini-2.5-flash
LEADGEN_SMART_MODEL=gemini-2.5-pro

# Pipeline tuning
LEADGEN_MAX_ITERATIONS=3      # discovery loop rounds
LEADGEN_DEEP_DIVE_TOP_N=6     # leads that get per-lead signal research
LEADGEN_OUTPUT_DIR=output     # where CSV / report files land
