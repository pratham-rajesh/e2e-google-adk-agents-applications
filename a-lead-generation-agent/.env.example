# ===== Pick ONE backend. Everything here is free to use. =====
LEADGEN_PROVIDER=gemini        # gemini | ollama | groq | openrouter | litellm

# --- gemini: free tier, no billing needed. Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-free-ai-studio-key
# Free tier is rate limited (a few requests/minute), so keep the run small:
LEADGEN_MAX_ITERATIONS=2
LEADGEN_DEEP_DIVE_TOP_N=3

# --- ollama: fully local & free. Install from https://ollama.com then:  ollama pull qwen3:8b
# (needs `pip install -e ".[local]"`; an 8B model fits in 8 GB of VRAM)
# LEADGEN_PROVIDER=ollama
# OLLAMA_API_BASE=http://localhost:11434
# LEADGEN_FAST_MODEL=ollama_chat/qwen3:8b

# --- groq: free tier, fast. Key from https://console.groq.com
# LEADGEN_PROVIDER=groq
# GROQ_API_KEY=...

# --- openrouter: ":free" models. Key from https://openrouter.ai
# LEADGEN_PROVIDER=openrouter
# OPENROUTER_API_KEY=...

# Override model ids for any provider (LiteLLM naming for non-Gemini)
# LEADGEN_FAST_MODEL=
# LEADGEN_SMART_MODEL=

# Search: auto = Google Search grounding on Gemini, DuckDuckGo (no key) otherwise
# LEADGEN_SEARCH_BACKEND=auto   # auto | google | ddg

LEADGEN_OUTPUT_DIR=output
