# ===== Two separate things need configuring =====
# (1) the ORCHESTRATOR model (planner/worker/reviewer, runs inside ADK)   -> GEMCLI_PROVIDER ...
# (2) Gemini CLI itself (the tool)                                         -> its own auth, below
# Everything here has a free option.

# ---------- (1) Orchestrator: pick ONE ----------
GEMCLI_PROVIDER=gemini         # gemini | ollama | groq | openrouter | litellm

# gemini: free tier, no billing. Key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-free-ai-studio-key

# ollama: fully local & free (needs `pip install -e ".[local]"`, `ollama pull qwen3:8b`)
# GEMCLI_PROVIDER=ollama
# OLLAMA_API_BASE=http://localhost:11434
# groq / openrouter: GEMCLI_PROVIDER=groq + GROQ_API_KEY=...   |   GEMCLI_PROVIDER=openrouter + OPENROUTER_API_KEY=...
# Override model ids (LiteLLM naming for non-Gemini):
# GEMCLI_FAST_MODEL=
# GEMCLI_SMART_MODEL=

# ---------- (2) Gemini CLI ----------
# Install:  npm install -g @google/gemini-cli     (needs Node 20+)
# Auth, option A (free): run `gemini` once interactively and "Login with Google" (personal account,
#   free tier). Credentials are cached in ~/.gemini and picked up automatically (HOME/USERPROFILE
#   are forwarded to the subprocess).
# Auth, option B (free): a free AI Studio key, used by BOTH the CLI and the orchestrator:
# GEMINI_API_KEY=your-free-ai-studio-key
GEMCLI_BIN=gemini                 # program name, path, or a JSON list like ["python","fake.py"]
# GEMCLI_CLI_MODEL=gemini-2.5-flash   # pass `-m` to the CLI (default: the CLI's own choice)
GEMCLI_APPROVAL_MODE=default      # default (headless = read-only) | plan | auto_edit | yolo (needs GEMCLI_ALLOW_YOLO=1)
# GEMCLI_SANDBOX=1                # pass --sandbox (needs Docker/Podman or macOS seatbelt)
# GEMCLI_SKIP_TRUST=1             # pass --skip-trust if the CLI refuses to run in an "untrusted" folder

# ---------- Limits & paths ----------
GEMCLI_WORKSPACE=workspace        # the ONLY tree the CLI may run in (repos are cloned under it)
GEMCLI_OUTPUT_DIR=output          # run records (JSON audit trail)
GEMCLI_TIMEOUT=300                # seconds per CLI call
GEMCLI_MAX_TIMEOUT=900            # ceiling for a timeout requested by the LLM
GEMCLI_MAX_OUTPUT_CHARS=20000
GEMCLI_GIT_HOSTS=github.com,gitlab.com   # hosts clone_repository may fetch from

# ---------- HTTP server (server.py) ----------
# GEMCLI_SERVER_TOKEN=change-me   # require "Authorization: Bearer change-me" on POST /analyze
# GEMCLI_MAX_CONCURRENT_RUNS=2
# GEMCLI_WEB_UI=1                 # also serve the ADK web UI
