# Everything here has a free option. Copy to .env.

# ---------- Model backend: pick ONE ----------
BUGASSIST_PROVIDER=gemini      # gemini | ollama | groq | openrouter | litellm

# gemini: free tier, no billing. Key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-free-ai-studio-key

# ollama: fully local & free (pip install -e ".[local]", `ollama pull qwen3:8b`)
# BUGASSIST_PROVIDER=ollama
# OLLAMA_API_BASE=http://localhost:11434
# groq / openrouter: BUGASSIST_PROVIDER=groq + GROQ_API_KEY=...  |  BUGASSIST_PROVIDER=openrouter + OPENROUTER_API_KEY=...
# Override model ids (LiteLLM naming for non-Gemini):
# BUGASSIST_MODEL=             # triage agent
# BUGASSIST_RESEARCH_MODEL=    # cause_researcher

# ---------- Search (for the researcher) ----------
# auto = Google Search grounding on Gemini, keyless DuckDuckGo otherwise. Or force: google | ddg
# BUGASSIST_SEARCH_BACKEND=auto

# ---------- Ticket store & guardrails ----------
# BUGASSIST_DB=data/tickets.db            # SQLite file used by the MCP server (seeded with demo tickets when empty)
# BUGASSIST_REQUIRE_CONFIRMATION=1        # human approves every write; 0 only for unattended batch use
# BUGASSIST_MAX_WRITES=3                  # successful ticket writes allowed per session
# BUGASSIST_DUP_BLOCK=0.6                 # refuse create_ticket when the latest duplicate check scored >= this (1.01 disables)
