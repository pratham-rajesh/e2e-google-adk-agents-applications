# Everything here has a free option. Copy to .env.

# ---------- Model backend: pick ONE ----------
CODEREVIEW_PROVIDER=gemini      # gemini | ollama | groq | openrouter | litellm

# gemini: free tier, no billing. Key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-free-ai-studio-key

# ollama: fully local & free (pip install -e ".[local]", `ollama pull qwen3:8b`)
# CODEREVIEW_PROVIDER=ollama
# OLLAMA_API_BASE=http://localhost:11434
# groq / openrouter: CODEREVIEW_PROVIDER=groq + GROQ_API_KEY=...  |  CODEREVIEW_PROVIDER=openrouter + OPENROUTER_API_KEY=...
# Override model ids (LiteLLM naming for non-Gemini):
# CODEREVIEW_MODEL=             # fast role: analysis notes, style notes, routing, fix summary
# CODEREVIEW_CODER_MODEL=       # coder role: test writing, final review, the fixer
# CODEREVIEW_STRICT_SCHEMA=0    # 1 = hard Pydantic output_schema on the final review (Gemini only; ADK raises on bad JSON)

# ---------- Sandbox for the generated tests ----------
# CODEREVIEW_SANDBOX=subprocess   # subprocess | docker | off. docker needs: docker build -f sandbox/Dockerfile.sandbox -t code-review-sandbox sandbox
# CODEREVIEW_SANDBOX_TIMEOUT=20
# CODEREVIEW_SANDBOX_MAX_OUTPUT=20000
# CODEREVIEW_SANDBOX_MEMORY_MB=512
# CODEREVIEW_SANDBOX_IMAGE=code-review-sandbox:latest
# CODEREVIEW_ALLOW_RISKY_EXEC=0   # 1 = run code that imports socket/subprocess/... in the plain subprocess sandbox (trusted code only)

# ---------- Limits & output ----------
# CODEREVIEW_MAX_CODE_CHARS=20000
# CODEREVIEW_FIX_MAX_ITERATIONS=3
# CODEREVIEW_MAX_LINE_LENGTH=100
# CODEREVIEW_COMPLEXITY_LIMIT=10
# CODEREVIEW_ARTIFACT_DIR=artifacts   # persist review/fix artifacts on disk (default: in memory)

# ---------- HTTP service (server.py) ----------
# CODEREVIEW_SERVER_TOKEN=            # require "Authorization: Bearer <token>" on POST /review
# CODEREVIEW_MAX_CONCURRENT_RUNS=2
