# Image for CODEREVIEW_SANDBOX=docker. It only needs Python and pytest: the review service starts it per run with
# no network, a read-only root, dropped capabilities, a non-root user and memory/CPU/pid limits (see
# code_review_assistant/tools/sandbox.py::docker_command). UNVERIFIED: not built on the author's machine.
#   docker build -f sandbox/Dockerfile.sandbox -t code-review-sandbox:latest sandbox
FROM python:3.12-slim
RUN pip install --no-cache-dir "pytest>=8" && useradd --uid 65534 --no-create-home --shell /usr/sbin/nologin sandbox || true
WORKDIR /work
